{
  "name": "mephisto-ai-companion",
  "version": "0.5.0",
  "description": "Mephisto - a local-first AI companion desktop application",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "better-sqlite3": "^11.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.172.0",
    "@pixiv/three-vrm": "^3.2.0",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.2",
    "electron": "^34.1.1"
  },
  "build": {
    "appId": "com.mephisto.companion",
    "productName": "Mephisto",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "mac": {
      "category": "public.app-category.lifestyle"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
